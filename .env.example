# Copy to .env and .dev.vars — never commit real secrets.
# Supabase: Project Settings → API Keys (use project URL without /rest/v1/)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# OpenRouter: https://openrouter.ai/settings/keys (optional credit limit recommended)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
