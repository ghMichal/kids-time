---
import Topbar from "@/components/Topbar.astro";

interface Props {
  showTopbar?: boolean;
}

const { showTopbar = false } = Astro.props;
---

<div class="bg-warm-landing relative min-h-screen w-full overflow-hidden">
  <div class="pointer-events-none absolute -top-20 -right-16 h-72 w-72 rounded-full bg-amber-200/50 blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/2 -left-20 h-64 w-64 rounded-full bg-orange-200/40 blur-3xl"></div>
  <div class="pointer-events-none absolute right-1/4 bottom-0 h-48 w-48 rounded-full bg-rose-200/35 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-5xl px-4 py-6 sm:px-8 sm:py-8">
    {showTopbar && <Topbar />}
    <slot />
  </div>
</div>
