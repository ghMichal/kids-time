---
const { user } = Astro.locals;
---

<div
  class="mb-6 flex items-center justify-between rounded-xl border border-amber-100 bg-white/80 px-4 py-2.5 text-sm text-slate-700 shadow-sm backdrop-blur-sm"
>
  {
    user ? (
      <>
        <span class="text-slate-500">{user.email}</span>
        <div class="flex items-center gap-3">
          <a
            href="/suggestions"
            class="font-medium text-amber-800 transition-colors hover:text-amber-950 hover:underline"
          >
            Propozycje
          </a>
          <a href="/events" class="font-medium text-amber-800 transition-colors hover:text-amber-950 hover:underline">
            Moje wydarzenia
          </a>
          <a
            href="/events/shared"
            class="font-medium text-amber-800 transition-colors hover:text-amber-950 hover:underline"
          >
            Udostępnione
          </a>
          <a
            href="/dashboard"
            class="font-medium text-amber-800 transition-colors hover:text-amber-950 hover:underline"
          >
            Panel
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="font-medium text-amber-800 transition-colors hover:text-amber-950 hover:underline"
            >
              Wyloguj
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="font-medium text-slate-500">
          <span class="font-semibold text-slate-800">kids-time</span>
          <span class="hidden text-slate-500 sm:inline"> — planuj aktywności z rodziną</span>
        </span>
        <div class="flex gap-3">
          <a
            href="/auth/signin"
            class="font-medium text-amber-800 transition-colors hover:text-amber-950 hover:underline"
          >
            Zaloguj się
          </a>
          <a
            href="/auth/signup"
            class="font-medium text-amber-800 transition-colors hover:text-amber-950 hover:underline"
          >
            Załóż konto
          </a>
        </div>
      </>
    )
  }
</div>
