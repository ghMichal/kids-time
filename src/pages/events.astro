---
import AppShell from "@/components/AppShell.astro";
import PanelCard from "@/components/PanelCard.astro";
import EventsLibraryPage from "@/components/events/EventsLibraryPage";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Moje wydarzenia — kids-time">
  <AppShell showTopbar>
    <div class="flex min-h-[calc(100vh-8rem)] justify-center py-8">
      <PanelCard maxWidth="md">
        <EventsLibraryPage client:load />
      </PanelCard>
    </div>
  </AppShell>
</Layout>
