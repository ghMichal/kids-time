---
import AppShell from "@/components/AppShell.astro";
import PanelCard from "@/components/PanelCard.astro";
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Panel — kids-time">
  <AppShell showTopbar>
    <div class="flex min-h-[calc(100vh-8rem)] items-center justify-center py-8">
      <PanelCard maxWidth="md">
        <div class="text-center">
          <h1 class="mb-4 text-3xl font-bold text-slate-900">Panel</h1>
          <p class="text-slate-600">
            Witaj, <span class="font-semibold text-slate-900">{user?.email}</span>
          </p>
          <p class="mt-2 text-sm text-slate-500">Ta strona jest dostępna tylko dla zalogowanych rodziców.</p>
          <form method="POST" action="/api/auth/signout" class="mt-6">
            <button
              type="submit"
              class="rounded-xl border border-amber-200 bg-white px-5 py-2.5 text-sm font-semibold text-amber-900 shadow-sm transition-colors hover:bg-amber-50"
            >
              Wyloguj
            </button>
          </form>
        </div>
      </PanelCard>
    </div>
  </AppShell>
</Layout>
