---
import AppShell from "@/components/AppShell.astro";
import PanelCard from "@/components/PanelCard.astro";
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
const info = Astro.url.searchParams.get("info");
---

<Layout title="Zaloguj się — kids-time">
  <AppShell>
    <div class="flex min-h-[calc(100vh-6rem)] items-center justify-center py-8">
      <PanelCard>
        <h1 class="mb-6 text-center text-2xl font-bold text-slate-900">Zaloguj się</h1>
        {
          info && (
            <p class="mb-4 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">{info}</p>
          )
        }
        <SignInForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm text-slate-600">
          Nie masz konta?{" "}
          <a href="/auth/signup" class="font-medium text-amber-800 hover:underline"> Załóż konto </a>
        </p>
      </PanelCard>
    </div>
  </AppShell>
</Layout>
