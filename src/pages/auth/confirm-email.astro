---
import AppShell from "@/components/AppShell.astro";
import PanelCard from "@/components/PanelCard.astro";
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Konto utworzone",
      description: "Twoje konto jest gotowe. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź skrzynkę",
      description: "Wysłaliśmy link aktywacyjny na Twój adres e-mail. Kliknij go, aby dokończyć rejestrację.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={`${content.heading} — kids-time`}>
  <AppShell>
    <div class="flex min-h-[calc(100vh-6rem)] items-center justify-center py-8">
      <PanelCard>
        <div class="text-center">
          <div class="mb-4 text-5xl">{content.emoji}</div>
          <h1 class="mb-3 text-2xl font-bold text-slate-900">{content.heading}</h1>
          <p class="mb-6 text-slate-600">{content.description}</p>
          <a href="/auth/signin" class="text-sm font-medium text-amber-800 hover:underline">
            {content.linkText}
          </a>
        </div>
      </PanelCard>
    </div>
  </AppShell>
</Layout>
