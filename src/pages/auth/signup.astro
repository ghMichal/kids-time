---
import AppShell from "@/components/AppShell.astro";
import PanelCard from "@/components/PanelCard.astro";
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Załóż konto — kids-time">
  <AppShell>
    <div class="flex min-h-[calc(100vh-6rem)] items-center justify-center py-8">
      <PanelCard>
        <h1 class="mb-6 text-center text-2xl font-bold text-slate-900">Załóż konto</h1>
        <SignUpForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm text-slate-600">
          Masz już konto?{" "}
          <a href="/auth/signin" class="font-medium text-amber-800 hover:underline"> Zaloguj się </a>
        </p>
      </PanelCard>
    </div>
  </AppShell>
</Layout>
