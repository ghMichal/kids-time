#!/usr/bin/env sh
# Print GitHub Actions list URL. Git has no post-push hook.

# Do not read git's pre-push stdin (TTY or ref list) — that waits for Enter.
exec </dev/null

if [ -n "${KIDS_TIME_CI_LINK_FROM_WRAPPER:-}" ]; then
  exit 0
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
sh "$ROOT/scripts/print-ci-run-link.sh"
exit 0
